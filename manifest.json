{
  "manifest_version": 2,
  "name": "YouTube → Seerr",
  "version": "1.0.0",
  "description": "Adds a \"Request in Seerr\" button to movie trailers on YouTube.",
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-seerr@tim.rip",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["storage"],
  "optional_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "browser_action": {
    "default_icon": "icons/icon.svg",
    "default_title": "Seerr settings"
  }
}
